# Backend API URL
VITE_API_URL=http://localhost:5000/api

# Optional: enables real user accounts (Login page) via Supabase Auth.
# Create a free project at https://supabase.com, then copy these from
# Project Settings -> API. Without them, the app runs fine but Login
# shows an honest "not configured" message instead of faking success.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
